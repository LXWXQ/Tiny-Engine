# 构建产物
imgui.ini
build/
build-*/
out/
.vs/
*.user

# 第三方库（体积大、版本钉在 tools/SetupDependencies.ps1，可还原，不入库）
3rdParty/

# 编译出的 SPIR-V（构建时生成）
*.spv

# 调试 / 剖析工具在仓库根直接运行时可能产生的默认输出
/gpu_timing.csv
/screenshot.png
/validation.jsonl
/diagnostics_selftest.jsonl
/*.tracy
/*.log
/profiles/
/bundles/
/baseline/
/.tmp/
# Config 自检在受限环境（TEMP 不可写）会退回到工作目录下的隐藏目录
.tiny-config-selftest/
.tiny-streaming-selftest/
node_modules/
node_modules.orig/

# 编辑器偏好（本机习惯，不进版本库）
config/editor.json

# 启动失败日志（运行时产物）
startup-error.log

# 管线缓存（运行时产物，驱动/显卡一变就作废）
pipeline_cache.bin

# 本地临时文件 / 编辑器布局备份
/tmp_*
config/*.ini.bak

# 本地跑 tools/Validate.ps1 时的输出（后台重定向的产物，不入库）
validate_bg.log
validate_bg.err
# 本地一次性取证产物：重定向日志、比对脚本、截图（不入库）
_*.log
_*.err
_*.jsonl
_*.png
_*.py
