#pragma once

// ===========================================================================
// 本文件由 CMake 从 cmake/AssetPaths.h.in 生成，请勿直接修改。
//
// 资源根目录在「CMake 配置阶段」就被固化成绝对路径，这样无论从哪个工作目录
// 启动 exe，都能找到 shader 和 Resources。
//
// 原实现使用的是一组只有"工作目录恰好等于 build/Debug"时才成立的相对路径：
//     shader    : "../shaders/xxx.spv"  -> build/shaders/
//     resources : "../../Resources/"   -> <工程根>/Resources/
// 一旦换 IDE、切到 Release 配置（路径变成 build/Release）或直接双击 exe，
// 就会在 Pipeline::readFile / stbi_load 处抛 "failed to open file"。
//
// 注意：移动工程目录或换机器后，需要重新运行一次 CMake 配置。
// ===========================================================================

#define TINY_SHADER_DIR   "@CMAKE_CURRENT_BINARY_DIR@/shaders/"
#define TINY_RESOURCE_DIR "@CMAKE_CURRENT_SOURCE_DIR@/Resources/"

// 运行时配置文件（W1）。放在工程根的 config/ 下：
//   * 不依赖工作目录（和上面两个路径同样的理由）
//   * Debug / Release 共享同一份用户设置
//   * 进版本库，充当"默认预设"
#define TINY_CONFIG_PATH  "@TINY_CONFIG_DIR@/engine.json"

// 编辑器偏好（面板可见性 / Gizmo 模式 / 最近打开的场景）。
// 与 engine.json 分开：那份是进版本库的默认预设，这份是本机习惯，不进版本库。
#define TINY_EDITOR_CONFIG_PATH "@TINY_CONFIG_DIR@/editor.json"

// ImGui 的窗口布局持久化文件。和 engine.json 放在同一个目录，
// 保证仓库根目录始终只有 README.md。
#define TINY_IMGUI_INI_PATH "@TINY_CONFIG_DIR@/imgui.ini"
