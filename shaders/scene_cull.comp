#version 450

// F1：按组做视锥剔除 + Hi-Z 遮挡剔除，并把可见组的绘制参数写进 indirect 命令。
//
// 一个组 = 一个（模型, 子网格）。同一个子网格被多个实体复用时，这些实例在实例缓冲里连续排列，
// 一条命令用 instanceCount = N 就能一次画完（实例化）。剔除按组的并集世界 AABB 做，
// 属于保守剔除：组内任一实例可见，整组可见。
//
// Hi-Z 用的是「上一帧最后」的深度金字塔（本帧几何画完才重建），相机帧间连续时漏判代价极小；
// 金字塔存线性视深度（-viewZ），越大越远，每级取 2x2 最大值，所以「物体最近点比矩形内最远面还远」
// 才判定被遮挡 —— 宁可少剔除，不误剔。

layout(local_size_x = 64) in;

struct GroupRecord
{
    vec4 boundsMin;   // xyz = 世界 AABB 下界，w = 1 表示包围盒有效
    vec4 boundsMax;
    uvec4 draw;       // x = firstIndex, y = indexCount, z = vertexOffset, w = firstInstance
    uvec4 counts;     // x = instanceCount, y = materialSlot, z = merged, w = 保留
};

layout(set = 0, binding = 0) readonly buffer GroupBuffer
{
    GroupRecord groups[];
} groupBuffer;

layout(set = 0, binding = 1) writeonly buffer CommandBuffer
{
    // 用 5 个 uint 手写而不是结构体数组：避免 std430 对结构体成员对齐的解释差异。
    uint commands[];
} commandBuffer;

layout(set = 0, binding = 2) readonly buffer FrameBuffer
{
    mat4 viewProjection;
    mat4 view;
    vec4 planes[6];
    vec4 screen;       // x = 最小屏幕像素阈值, y = 视口高度, z = 投影 [1][1]
    uvec4 params;      // x = groupCount, z = 1 表示 Hi-Z 可用
} frame;

layout(set = 0, binding = 3) buffer StatsBuffer
{
    // [0] = (总组数, 可见组数, 被剔除组数, 可见实例数)
    // [1] = (可见三角形, 可见顶点, 遮挡测试组数, 遮挡剔除组数)
    // [2] = (屏幕误差测试组数, 屏幕误差剔除组数, 保留, 保留)
    uvec4 stats[3];
} statsBuffer;

layout(set = 0, binding = 4) uniform sampler2D hizPyramid;

layout(push_constant) uniform Push
{
    uvec4 params;   // x = groupCount, y = Hi-Z 宽, z = Hi-Z 高, w = Hi-Z 层数
} push;

const uint kCommandWords = 5u;
const float kOcclusionBias = 0.05;

bool frustumVisible(vec3 minimum, vec3 maximum)
{
    const vec3 center = (minimum + maximum) * 0.5;
    const vec3 extent = (maximum - minimum) * 0.5;
    const float radius = length(extent);
    for (int plane = 0; plane < 6; ++plane)
    {
        if (dot(frame.planes[plane].xyz, center) + frame.planes[plane].w < -radius)
            return false;
    }
    return true;
}

// 屏幕空间误差剔除：投影后包围球半径小于阈值像素的组直接丢弃。
// 这是 LOD 选择的前置件 —— 有了 LOD 链以后，这里会改成按误差选级而不是剔除。
bool tooSmallOnScreen(vec3 minimum, vec3 maximum)
{
    if (frame.screen.x <= 0.0 || frame.screen.y <= 0.0)
        return false;

    const vec3 center = (minimum + maximum) * 0.5;
    const float radius = length((maximum - minimum) * 0.5);
    const vec3 eye = (inverse(frame.view))[3].xyz;
    const float distance = max(length(center - eye), 1.0e-3);
    const float pixels = radius * (0.5 * frame.screen.y * frame.screen.z) / distance;
    return pixels < frame.screen.x;
}

bool occludedByHiZ(vec3 minimum, vec3 maximum)
{
    if (frame.params.z == 0u || push.params.w == 0u)
        return false;

    vec2 uvMin = vec2(1.0e9);
    vec2 uvMax = vec2(-1.0e9);
    float nearest = 1.0e9;
    for (int corner = 0; corner < 8; ++corner)
    {
        const vec3 point = vec3((corner & 1) != 0 ? maximum.x : minimum.x,
                                (corner & 2) != 0 ? maximum.y : minimum.y,
                                (corner & 4) != 0 ? maximum.z : minimum.z);
        const vec4 clip = frame.viewProjection * vec4(point, 1.0);
        if (clip.w <= 1.0e-5)
            return false;   // 有顶点在相机背后：不做遮挡判断
        const vec3 ndc = clip.xyz / clip.w;
        const vec2 uv = ndc.xy * 0.5 + 0.5;
        uvMin = min(uvMin, uv);
        uvMax = max(uvMax, uv);
        nearest = min(nearest, -(frame.view * vec4(point, 1.0)).z);
    }

    // 选择让投影矩形大约占 1~2 个 texel 的那一级：矩形越大，用的级别越粗。
    const vec2 rectPixels = max((uvMax - uvMin) * vec2(push.params.y, push.params.z), vec2(1.0));
    const float largest = max(rectPixels.x, rectPixels.y);
    const int level = clamp(int(ceil(log2(largest))), 0, int(push.params.w) - 1);

    const vec2 clampedMin = clamp(uvMin, vec2(0.0), vec2(1.0));
    const vec2 clampedMax = clamp(uvMax, vec2(0.0), vec2(1.0));
    float farthest = 0.0;
    for (int corner = 0; corner < 4; ++corner)
    {
        const vec2 uv = vec2((corner & 1) != 0 ? clampedMax.x : clampedMin.x,
                             (corner & 2) != 0 ? clampedMax.y : clampedMin.y);
        farthest = max(farthest, textureLod(hizPyramid, uv, float(level)).r);
    }
    return nearest > farthest + kOcclusionBias;
}

void main()
{
    const uint groupIndex = gl_GlobalInvocationID.x;
    if (groupIndex >= push.params.x)
        return;

    const uint base = groupIndex * kCommandWords;
    const GroupRecord group = groupBuffer.groups[groupIndex];
    atomicAdd(statsBuffer.stats[0].x, 1u);

    bool visible = true;
    if (group.boundsMin.w > 0.5)
    {
        visible = frustumVisible(group.boundsMin.xyz, group.boundsMax.xyz);
        if (visible && frame.screen.x > 0.0)
        {
            atomicAdd(statsBuffer.stats[2].x, 1u);   // 做过屏幕空间误差测试的组数
            if (tooSmallOnScreen(group.boundsMin.xyz, group.boundsMax.xyz))
            {
                atomicAdd(statsBuffer.stats[2].y, 1u);   // 其中投影太小的组数
                visible = false;
            }
        }
        if (visible && frame.params.z != 0u)
        {
            atomicAdd(statsBuffer.stats[1].z, 1u);   // 做过遮挡测试的组数
            if (occludedByHiZ(group.boundsMin.xyz, group.boundsMax.xyz))
            {
                atomicAdd(statsBuffer.stats[1].w, 1u);   // 其中判定被遮挡的组数
                visible = false;
            }
        }
    }

    if (!visible)
    {
        atomicAdd(statsBuffer.stats[0].z, 1u);
        commandBuffer.commands[base + 0u] = 0u;
        commandBuffer.commands[base + 1u] = 0u;
        commandBuffer.commands[base + 2u] = 0u;
        commandBuffer.commands[base + 3u] = 0u;
        commandBuffer.commands[base + 4u] = 0u;
        return;
    }

    const uint instanceCount = group.counts.x;
    atomicAdd(statsBuffer.stats[0].y, 1u);
    atomicAdd(statsBuffer.stats[0].w, instanceCount);
    atomicAdd(statsBuffer.stats[1].x, instanceCount * (group.draw.y / 3u));
    atomicAdd(statsBuffer.stats[1].y, instanceCount * group.draw.y);

    commandBuffer.commands[base + 0u] = group.draw.y;   // indexCount
    commandBuffer.commands[base + 1u] = instanceCount;  // instanceCount
    commandBuffer.commands[base + 2u] = group.draw.x;   // firstIndex
    commandBuffer.commands[base + 3u] = group.draw.z;   // vertexOffset
    commandBuffer.commands[base + 4u] = group.draw.w;   // firstInstance
}
