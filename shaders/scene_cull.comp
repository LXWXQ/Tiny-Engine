#version 450

// F1：按组做视锥剔除 + Hi-Z 遮挡剔除，并把可见组的绘制参数写进 indirect 命令。
//
// 一个组 = 一个（模型, 子网格）。同一个子网格被多个实体复用时，这些实例在实例缓冲里连续排列，
// 一条命令用 instanceCount = N 就能一次画完（实例化）。剔除按组的并集世界 AABB 做，
// 属于保守剔除：组内任一实例可见，整组可见。组级通过之后再做实例级剔除：可见实例被压成
// 每组一段紧凑区间，命令的 firstInstance / instanceCount 换成这段区间（见文件下半部分）。
//
// Hi-Z 用的是「上一帧最后」的深度金字塔（本帧几何画完才重建），相机帧间连续时漏判代价极小；
// 金字塔存线性视深度（-viewZ），越大越远，每级取 2x2 最大值，所以「物体最近点比矩形内最远面还远」
// 才判定被遮挡 —— 宁可少剔除，不误剔。

layout(local_size_x = 64) in;

struct GroupRecord
{
    vec4 boundsMin;   // xyz = 世界 AABB 下界，w = 1 表示包围盒有效
    vec4 boundsMax;
    uvec4 draw;       // x = firstIndex, y = indexCount, z = vertexOffset, w = firstInstance
    uvec4 counts;     // x = instanceCount, y = materialSlot, z = merged, w = 保留
};

layout(set = 0, binding = 0) readonly buffer GroupBuffer
{
    GroupRecord groups[];
} groupBuffer;

layout(set = 0, binding = 1) buffer CommandBuffer
{
    // 用 5 个 uint 手写而不是结构体数组：避免 std430 对结构体成员对齐的解释差异。
    // 读回只发生在紧凑区间那一步：前缀和要先看组级剔除有没有把这条命令整条写成 0。
    uint commands[];
} commandBuffer;

layout(set = 0, binding = 2) readonly buffer FrameBuffer
{
    mat4 viewProjection;
    mat4 view;
    vec4 planes[6];
    vec4 screen;       // x = 最小屏幕像素阈值, y = 视口高度, z = 投影 [1][1]
    uvec4 params;      // x = groupCount, z = 1 表示 Hi-Z 可用
} frame;

layout(set = 0, binding = 3) buffer StatsBuffer
{
    // [0] = (总组数, 可见组数, 被剔除组数, 可见实例数)
    // [1] = (可见三角形, 可见顶点, 遮挡测试组数, 遮挡剔除组数)
    // [2] = (屏幕误差测试组数, 屏幕误差剔除组数, 保留, 保留)
    // [3] = (实例级视锥测试数, 其中在视锥内, 保留, 保留)
    //
    // 缓冲固定 4 个 uvec4 = 64 字节，与 C++ SceneGpuBatch::Stats 的
    // static_assert 同一口径；扩槽要同时改这里和 Stats，否则写越界。
    uvec4 stats[4];
} statsBuffer;

layout(set = 0, binding = 4) uniform sampler2D hizPyramid;

// 实例缓冲：和 C++ 的 SceneGpuBatch::InstanceRecord 是同一份 224 字节记录（mrt.vert 读的是同一个
// 缓冲，只是绑在图形 set 上）。这里只读它做实例级视锥统计，不写。
struct InstanceRecord
{
    mat4 model;
    mat4 normal;
    uvec4 flags;       // x = materialId, y = materialValid, z = alphaMasked, w = albedoFallback
    vec4 misc;         // x = alphaCutoff, y = checkerScale, z = terrainMode, w = 保留
    vec4 uvTransform;
    vec4 boundsMin;    // xyz = 局部 AABB 下界，w = 1 表示包围盒有效
    vec4 boundsMax;
    uvec4 draw;        // 顶点/片元阶段用，这里不读
};

layout(set = 0, binding = 5) readonly buffer InstanceBuffer
{
    InstanceRecord instances[];
} instanceBuffer;

// 组级紧凑区间：一个组一个 uvec4。x = 本组可见实例数（模式 1 用 atomicAdd 领号），
// y = 本组在 remap 表里的起点（模式 2 写），z/w 保留。CPU 每帧和 stats 一起清零。
layout(set = 0, binding = 6) buffer CullGroupBuffer
{
    uvec4 cullGroups[];
} cullGroupBuffer;

// 实例 remap + 名次混排在同一块缓冲里：[0, capacity) 放 remap，[capacity, 2 * capacity) 放名次。
// 名次 0xFFFFFFFFu 表示「该实例不可见」，remap 里只放可见实例的下标、且按组连续。
layout(set = 0, binding = 7) buffer ScratchBuffer
{
    uint scratch[];
} scratchBuffer;

layout(push_constant) uniform Push
{
    uvec4 params;   // x = groupCount, y = Hi-Z 宽, z = Hi-Z 高, w = Hi-Z 层数
    // 第二段：一次 dispatch 只做一件事，y 选阶段：
    //   0 = 组剔除（x 不用）, 1 = 实例视锥 + 领名次, 2 = 组前缀和,
    //   3 = 写紧凑索引, 4 = 恒等索引（实例级剔除关闭时的回退）。
    // z = remap 与名次在同一块缓冲里的分界（实例容量）；z == 0 表示实例级剔除关着，
    // 组剔除那一步要自己累加实例级统计，回退路径的读数才和 P2 第二步逐位相同。
    uvec4 more;     // x = count, y = mode, z = 实例容量
} push;

const uint kCommandWords = 5u;
const float kOcclusionBias = 0.05;

bool frustumVisible(vec3 minimum, vec3 maximum)
{
    const vec3 center = (minimum + maximum) * 0.5;
    const vec3 extent = (maximum - minimum) * 0.5;
    const float radius = length(extent);
    for (int plane = 0; plane < 6; ++plane)
    {
        if (dot(frame.planes[plane].xyz, center) + frame.planes[plane].w < -radius)
            return false;
    }
    return true;
}

// 屏幕空间误差剔除：投影后包围球半径小于阈值像素的组直接丢弃。
// 这是 LOD 选择的前置件 —— 有了 LOD 链以后，这里会改成按误差选级而不是剔除。
bool tooSmallOnScreen(vec3 minimum, vec3 maximum)
{
    if (frame.screen.x <= 0.0 || frame.screen.y <= 0.0)
        return false;

    const vec3 center = (minimum + maximum) * 0.5;
    const float radius = length((maximum - minimum) * 0.5);
    const vec3 eye = (inverse(frame.view))[3].xyz;
    const float distance = max(length(center - eye), 1.0e-3);
    const float pixels = radius * (0.5 * frame.screen.y * frame.screen.z) / distance;
    return pixels < frame.screen.x;
}

bool occludedByHiZ(vec3 minimum, vec3 maximum)
{
    if (frame.params.z == 0u || push.params.w == 0u)
        return false;

    vec2 uvMin = vec2(1.0e9);
    vec2 uvMax = vec2(-1.0e9);
    float nearest = 1.0e9;
    for (int corner = 0; corner < 8; ++corner)
    {
        const vec3 point = vec3((corner & 1) != 0 ? maximum.x : minimum.x,
                                (corner & 2) != 0 ? maximum.y : minimum.y,
                                (corner & 4) != 0 ? maximum.z : minimum.z);
        const vec4 clip = frame.viewProjection * vec4(point, 1.0);
        if (clip.w <= 1.0e-5)
            return false;   // 有顶点在相机背后：不做遮挡判断
        const vec3 ndc = clip.xyz / clip.w;
        const vec2 uv = ndc.xy * 0.5 + 0.5;
        uvMin = min(uvMin, uv);
        uvMax = max(uvMax, uv);
        nearest = min(nearest, -(frame.view * vec4(point, 1.0)).z);
    }

    // 选择让投影矩形大约占 1~2 个 texel 的那一级：矩形越大，用的级别越粗。
    const vec2 rectPixels = max((uvMax - uvMin) * vec2(push.params.y, push.params.z), vec2(1.0));
    const float largest = max(rectPixels.x, rectPixels.y);
    const int level = clamp(int(ceil(log2(largest))), 0, int(push.params.w) - 1);

    const vec2 clampedMin = clamp(uvMin, vec2(0.0), vec2(1.0));
    const vec2 clampedMax = clamp(uvMax, vec2(0.0), vec2(1.0));
    float farthest = 0.0;
    for (int corner = 0; corner < 4; ++corner)
    {
        const vec2 uv = vec2((corner & 1) != 0 ? clampedMax.x : clampedMin.x,
                             (corner & 2) != 0 ? clampedMax.y : clampedMin.y);
        farthest = max(farthest, textureLod(hizPyramid, uv, float(level)).r);
    }
    return nearest > farthest + kOcclusionBias;
}

// 与 C++ buildInstances 里 instanceInFrustum 同一套算式：同样的 6 个未归一化平面、同样的
// 「沿平面法线投影半长」半径。两边必须一起改，否则 GPU 读数和 CPU 的 instFrustum 对不上。
bool instanceInFrustum(uint instanceIndex)
{
    const InstanceRecord record = instanceBuffer.instances[instanceIndex];
    if (record.boundsMin.w <= 0.5)
        return true;   // 没有包围盒的实例按可见算：和组级剔除一样取保守口径

    const vec3 localCenter = (record.boundsMin.xyz + record.boundsMax.xyz) * 0.5;
    const vec3 localHalf = (record.boundsMax.xyz - record.boundsMin.xyz) * 0.5;
    const mat3 basis = mat3(record.model);
    const vec3 center = (record.model * vec4(localCenter, 1.0)).xyz;
    const vec3 worldHalf = abs(basis[0]) * localHalf.x + abs(basis[1]) * localHalf.y + abs(basis[2]) * localHalf.z;

    for (int plane = 0; plane < 6; ++plane)
    {
        const vec4 p = frame.planes[plane];
        const float distance = p.x * center.x + p.y * center.y + p.z * center.z + p.w;
        const float radius = abs(p.x) * worldHalf.x + abs(p.y) * worldHalf.y + abs(p.z) * worldHalf.z;
        if (distance + radius < 0.0)
            return false;
    }
    return true;
}

// ---------------------------------------------------------------------------
// 实例级剔除：三段 dispatch 把可见实例压成每组的紧凑区间。
//   1) 每实例测视锥 → 可见的从本组计数器领一个名次，不可见记 0xFFFFFFFFu。
//   2) 一个 invocation 串行过一遍组：把「本组可见实例数」变成「remap 起点」，顺带把命令的
//      instanceCount / firstInstance 换成紧凑后的值（组级剔除掉的组不复活）。
//   3) 每实例把名下写回 remap[起点 + 名次] = 实例下标；顶点着色器按它取 InstanceRecord。
// 实例缓冲本身不动，动的只有命令的实例区间与这张 remap 表 —— 所以一条 multidraw 仍然成立。
// ---------------------------------------------------------------------------
const uint kModeGroupCull = 0u;
const uint kModeInstanceRank = 1u;
const uint kModeGroupPrefix = 2u;
const uint kModeInstanceScatter = 3u;
const uint kModeIdentityRemap = 4u;
const uint kInstanceInvisible = 0xFFFFFFFFu;

// 实例 → 组：组按 firstInstance 升序、区间连续无空隙（CPU 组装实例缓冲时就按这个顺序拼），
// 所以二分找「最后一个 draw.w <= 实例下标」的组即可。
uint groupForInstance(uint instanceIndex)
{
    uint lo = 0u;
    uint hi = push.params.x;
    while (lo < hi)
    {
        const uint mid = (lo + hi) >> 1u;
        if (groupBuffer.groups[mid].draw.w <= instanceIndex)
            lo = mid + 1u;
        else
            hi = mid;
    }
    return lo == 0u ? 0u : lo - 1u;
}

// 模式 1：测视锥 + 领名次。
void rankInstanceVisibility()
{
    const uint instanceIndex = gl_GlobalInvocationID.x;
    if (instanceIndex >= push.more.x)
        return;

    atomicAdd(statsBuffer.stats[3].x, 1u);   // 做过实例视锥测试的实例数
    uint rank = kInstanceInvisible;
    if (instanceInFrustum(instanceIndex))
    {
        atomicAdd(statsBuffer.stats[3].y, 1u);   // 其中在视锥内的实例数
        rank = atomicAdd(cullGroupBuffer.cullGroups[groupForInstance(instanceIndex)].x, 1u);
    }
    scratchBuffer.scratch[push.more.z + instanceIndex] = rank;
}

// 模式 2：组前缀和 + 改写命令。组数只有几十到几百，一个 invocation 串行过完比并行扫描省事，
// 而且这一步本来就要顺手改 5 个 word 的间接命令，天然是「每组只写一次」。
void buildGroupPrefix()
{
    if (gl_GlobalInvocationID.x != 0u)
        return;

    uint running = 0u;
    for (uint groupIndex = 0u; groupIndex < push.params.x; ++groupIndex)
    {
        const uint commandBase = groupIndex * kCommandWords;
        const uint count = cullGroupBuffer.cullGroups[groupIndex].x;
        cullGroupBuffer.cullGroups[groupIndex].y = running;
        if (commandBuffer.commands[commandBase + 1u] == 0u)
            continue;   // 组级剔除已经把这条命令整条写成 0：不复活

        if (count == 0u)
        {
            commandBuffer.commands[commandBase + 0u] = 0u;
            commandBuffer.commands[commandBase + 1u] = 0u;
            commandBuffer.commands[commandBase + 2u] = 0u;
            commandBuffer.commands[commandBase + 3u] = 0u;
            commandBuffer.commands[commandBase + 4u] = 0u;
            continue;
        }

        const uint indexCount = groupBuffer.groups[groupIndex].draw.y;
        statsBuffer.stats[0].w += count;
        statsBuffer.stats[1].x += count * (indexCount / 3u);
        statsBuffer.stats[1].y += count * indexCount;
        commandBuffer.commands[commandBase + 1u] = count;      // instanceCount
        commandBuffer.commands[commandBase + 4u] = running;    // firstInstance
        running += count;
    }
}

// 模式 3：写紧凑索引。名次是模式 1 领好的，这里只搬运一次，不重复测视锥。
void scatterVisibleInstances()
{
    const uint instanceIndex = gl_GlobalInvocationID.x;
    if (instanceIndex >= push.more.x)
        return;

    const uint rank = scratchBuffer.scratch[push.more.z + instanceIndex];
    if (rank == kInstanceInvisible)
        return;

    const uint groupIndex = groupForInstance(instanceIndex);
    if (commandBuffer.commands[groupIndex * kCommandWords + 1u] == 0u)
        return;   // 组级剔除掉的组：名次作废

    scratchBuffer.scratch[cullGroupBuffer.cullGroups[groupIndex].y + rank] = instanceIndex;
}

// 模式 4：实例级剔除关闭时的回退 —— 写恒等索引。顶点着色器走同一段 remap 代码，
// 命令保持组级剔除写下的原值，画面上与「没有 remap」完全一致。
void writeIdentityRemap()
{
    const uint instanceIndex = gl_GlobalInvocationID.x;
    if (instanceIndex >= push.more.x)
        return;
    scratchBuffer.scratch[instanceIndex] = instanceIndex;
}

void main()
{
    if (push.more.y == kModeInstanceRank)
    {
        rankInstanceVisibility();
        return;
    }
    if (push.more.y == kModeGroupPrefix)
    {
        buildGroupPrefix();
        return;
    }
    if (push.more.y == kModeInstanceScatter)
    {
        scatterVisibleInstances();
        return;
    }
    if (push.more.y == kModeIdentityRemap)
    {
        writeIdentityRemap();
        return;
    }

    const uint groupIndex = gl_GlobalInvocationID.x;
    if (groupIndex >= push.params.x)
        return;

    const uint base = groupIndex * kCommandWords;
    const GroupRecord group = groupBuffer.groups[groupIndex];
    atomicAdd(statsBuffer.stats[0].x, 1u);

    bool visible = true;
    if (group.boundsMin.w > 0.5)
    {
        visible = frustumVisible(group.boundsMin.xyz, group.boundsMax.xyz);
        if (visible && frame.screen.x > 0.0)
        {
            atomicAdd(statsBuffer.stats[2].x, 1u);   // 做过屏幕空间误差测试的组数
            if (tooSmallOnScreen(group.boundsMin.xyz, group.boundsMax.xyz))
            {
                atomicAdd(statsBuffer.stats[2].y, 1u);   // 其中投影太小的组数
                visible = false;
            }
        }
        if (visible && frame.params.z != 0u)
        {
            atomicAdd(statsBuffer.stats[1].z, 1u);   // 做过遮挡测试的组数
            if (occludedByHiZ(group.boundsMin.xyz, group.boundsMax.xyz))
            {
                atomicAdd(statsBuffer.stats[1].w, 1u);   // 其中判定被遮挡的组数
                visible = false;
            }
        }
    }

    if (!visible)
    {
        atomicAdd(statsBuffer.stats[0].z, 1u);
        commandBuffer.commands[base + 0u] = 0u;
        commandBuffer.commands[base + 1u] = 0u;
        commandBuffer.commands[base + 2u] = 0u;
        commandBuffer.commands[base + 3u] = 0u;
        commandBuffer.commands[base + 4u] = 0u;
        return;
    }

    const uint instanceCount = group.counts.x;
    atomicAdd(statsBuffer.stats[0].y, 1u);
    // 实例级剔除开着时（more.z != 0），这三项交给前缀和那一步按紧凑后的数量累加；
    // 关着时在这里按组数量累加，回退路径的读数与 P2 第二步逐位相同。
    if (push.more.z == 0u)
    {
        atomicAdd(statsBuffer.stats[0].w, instanceCount);
        atomicAdd(statsBuffer.stats[1].x, instanceCount * (group.draw.y / 3u));
        atomicAdd(statsBuffer.stats[1].y, instanceCount * group.draw.y);
    }

    commandBuffer.commands[base + 0u] = group.draw.y;   // indexCount
    commandBuffer.commands[base + 1u] = instanceCount;  // instanceCount
    commandBuffer.commands[base + 2u] = group.draw.x;   // firstIndex
    commandBuffer.commands[base + 3u] = group.draw.z;   // vertexOffset
    commandBuffer.commands[base + 4u] = group.draw.w;   // firstInstance
}
